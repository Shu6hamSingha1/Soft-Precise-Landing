#!/usr/bin/env python3
"""
Integrated Hardware Landing System
- Flight Controller (MAVSDK)
- Image Processing (IMG_PROCESSOR)
- PLASMC Control Law
- Real-time telemetry logging
"""

import asyncio
import sys
import time
import numpy as np
from datetime import datetime

sys.path.insert(0, ".")

try:
    from flight_controller import FC
    from img_data import IMG_PROCESSOR
    from controller import PLASMC_Controller
    print("✓ All modules imported successfully")
except ImportError as e:
    print(f"✗ Import failed: {e}")
    sys.exit(1)


class HardwareLandingSystem:
    """Integrated hardware landing system"""
    
    def __init__(self, target_altitude=0.5):
        self.fc = None
        self.img_proc = None
        self.controller = PLASMC_Controller()
        self.target_altitude = target_altitude
        
        self.logs = {
            "time": [],
            "altitude": [],
            "velocity": [],
            "quaternion": [],
            "image_error": [],
            "control_output": [],
        }
    
    async def initialize(self):
        """Initialize flight controller and image processor"""
        print()
        print("=" * 60)
        print("Initializing Hardware Landing System")
        print("=" * 60)
        
        # Initialize flight controller
        print("\n1. Connecting to flight controller via MAVSDK...")
        self.fc = FC()
        await self.fc.start()
        print("   ✓ Flight controller connected")
        print(f"   Drone has quaternion: {self.fc.has_quat()}")
        
        # Initialize image processor
        print("\n2. Initializing camera (960×720 @ 47.8 FPS)...")
        self.img_proc = IMG_PROCESSOR(controller=self.fc)
        print("   ✓ Camera initialized")
        
        print("\n3. System ready for landing")
    
    async def arm_and_takeoff(self, height=2.0):
        """Arm drone and takeoff"""
        print()
        print("=" * 60)
        print("Arm and Takeoff")
        print("=" * 60)
        
        print(f"\nArming and taking off to {height}m...")
        await self.fc.arm_and_takeoff(takeoff_hgt=height)
        print("✓ Takeoff complete")
    
    async def landing_loop(self, duration=30):
        """Main landing control loop"""
        print()
        print("=" * 60)
        print("Landing Control Loop")
        print("=" * 60)
        print(f"Duration: {duration}s")
        print("Resolution: 960×720")
        print("Target altitude: {:.2f}m".format(self.target_altitude))
        print()
        
        start_time = time.time()
        frame_count = 0
        
        try:
            while time.time() - start_time < duration:
                # Get telemetry from flight controller
                quat = self.fc.getQuat()
                ang_vel = self.fc.getAngVelIMU()
                vel = self.fc.getVelBody()
                
                # Get image features
                img_features = self.img_proc.getImgFeatureParam()
                s_err = img_features[0] if len(img_features) > 0 else 0
                h_err = img_features[2] if len(img_features) > 2 else 0
                
                # Compute control
                tau_x, tau_y, thrust = self.controller.compute_control(s_err, h_err)
                
                # Send attitude rate command to drone
                await self.fc.send_attitude_rate(
                    roll_rate=tau_x,
                    pitch_rate=tau_y,
                    yaw_rate=0.0,
                    thrust=thrust
                )
                
                # Logging
                self.logs["time"].append(time.time() - start_time)
                self.logs["altitude"].append(self.fc.getPosBody()[2] if self.fc.getPosBody() else 0)
                self.logs["velocity"].append(np.linalg.norm(vel) if vel else 0)
                self.logs["quaternion"].append(quat if quat else [0, 0, 0, 0])
                self.logs["image_error"].append([s_err, h_err])
                self.logs["control_output"].append([tau_x, tau_y, thrust])
                
                frame_count += 1
                
                # Progress update
                if frame_count % 30 == 0:
                    elapsed = time.time() - start_time
                    alt = self.logs["altitude"][-1]
                    print(f"  {elapsed:.1f}s — Alt: {alt:.2f}m, Err: ({s_err:.3f}, {h_err:.3f}), Frames: {frame_count}")
                
                await asyncio.sleep(0.02)  # ~50 Hz
        
        except Exception as e:
            print(f"\n✗ Landing loop error: {e}")
            import traceback
            traceback.print_exc()
    
    async def land(self):
        """Land the drone"""
        print()
        print("Landing drone...")
        # Implementation depends on FC class land method
        # await self.fc.land()
        print("✓ Landing complete")
    
    async def cleanup(self):
        """Clean up resources"""
        print("\nCleaning up...")
        if self.img_proc:
            self.img_proc.close()
        if self.fc:
            await self.fc.close()
        print("✓ Cleanup complete")
    
    def print_summary(self):
        """Print test summary"""
        print()
        print("=" * 60)
        print("Test Summary")
        print("=" * 60)
        
        if not self.logs["time"]:
            print("No data collected")
            return
        
        duration = self.logs["time"][-1]
        frames = len(self.logs["time"])
        fps = frames / duration if duration > 0 else 0
        
        altitudes = [a for a in self.logs["altitude"] if a]
        if altitudes:
            min_alt = min(altitudes)
            max_alt = max(altitudes)
            avg_alt = np.mean(altitudes)
            print(f"Altitude: min={min_alt:.2f}m, max={max_alt:.2f}m, avg={avg_alt:.2f}m")
        
        print(f"Duration: {duration:.1f}s")
        print(f"Frames processed: {frames}")
        print(f"FPS: {fps:.1f}")


async def main():
    """Main entry point"""
    print("\n" + "=" * 60)
    print("Hardware Landing System - MAVSDK Integration Test")
    print("=" * 60)
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"Started: {now}")
    
    system = HardwareLandingSystem(target_altitude=0.5)
    
    try:
        # Initialize
        await system.initialize()
        
        # Arm and takeoff
        await system.arm_and_takeoff(height=2.0)
        
        # Landing control loop
        await system.landing_loop(duration=30)
        
        # Land
        await system.land()
        
        # Summary
        system.print_summary()
        
    except KeyboardInterrupt:
        print("\n\n✗ Interrupted by user")
    except Exception as e:
        print(f"\n✗ Error: {e}")
        import traceback
        traceback.print_exc()
    finally:
        await system.cleanup()
    
    print("\n" + "=" * 60)


if __name__ == "__main__":
    asyncio.run(main())

